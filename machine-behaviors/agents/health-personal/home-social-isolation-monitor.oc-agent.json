          "mid": "",
          "high": ""
        }
      },
      {
        "index": 5,
        "key": "transport_appointment_barrier_bit",
        "anchors": {
          "low": "",
          "mid": "",
          "high": ""
        }
      },
      {
        "index": 6,
        "key": "transport_dependent_risk_bit",
